{
	"compilerOptions": {
		// File Layout
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"types": ["node"],
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,

		// Environment Settings

		// Other Outputs
		"declaration": true,
		"declarationMap": true,

		// Recommended Options
		"jsx": "react-jsx",
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force"
	},
	"include": ["src/**/*"]
}
