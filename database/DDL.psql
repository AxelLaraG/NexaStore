-- Catalogo de esquemas
CREATE SCHEMA IF NOT EXISTS catalogs;
CREATE SCHEMA IF NOT EXISTS core;
CREATE SCHEMA IF NOT EXISTS finances;
CREATE SCHEMA IF NOT EXISTS logs;

-- DICCIONARIO DE CATÁLOGOS
CREATE TABLE IF NOT EXISTS catalogs.STAT_CAT_USRS(
    ID              INT PRIMARY KEY,
    STATUS          VARCHAR(20) NOT NULL,
    DESCRIPTION     VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.ROLE_CAT(
    ID              INT PRIMARY KEY,
    ROLE          VARCHAR(50) NOT NULL,
    STATUS          BOOLEAN NOT NULL,
    DESCRIPTION     VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.STAT_CAT_CORPS(
    ID          SMALLINT PRIMARY KEY,
    STATUS      VARCHAR(20) NOT NULL,
    DESCRIPTION VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.STAT_CAT_SH(
    ID          SMALLINT PRIMARY KEY,
    STATUS      VARCHAR(20) NOT NULL,
    DESCRIPTION VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.STAT_CAT_PR(
    ID          SMALLINT PRIMARY KEY,
    STATUS      VARCHAR(20) NOT NULL,
    DESCRIPTION VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.EXP_TYPE_CAT(
    ID          SMALLINT PRIMARY KEY,
    NAME      VARCHAR(100) NOT NULL,
    DESCRIPTION VARCHAR(150) NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.SETT_CAT(
    ID        SMALLINT PRIMARY KEY,
    SETTINGS  JSONB NOT NULL
);

CREATE TABLE IF NOT EXISTS catalogs.PLANS(
    ID              INT PRIMARY KEY,
    ID_SETTINGS     SMALLINT NOT NULL REFERENCES catalogs.SETT_CAT(ID),
    PRICE           NUMERIC(10, 2) NOT NULL
);

-- Tablas varias
CREATE TABLE IF NOT EXISTS core.USERS(
    ID          BIGINT PRIMARY KEY,
    ID_ROLE     INT NOT NULL REFERENCES catalogs.ROLE_CAT(ID),
    ID_STATUS   INT NOT NULL REFERENCES catalogs.STAT_CAT_USRS(ID),
    IS_ACTIVE   BOOLEAN NOT NULL,
    EMAIL       VARCHAR(100) UNIQUE NOT NULL,
    PHONE_NUM   VARCHAR(20),
    PASSWORD    VARCHAR(255) NOT NULL,
    NAME        VARCHAR(100) NOT NULL,
    LASTN_1     VARCHAR(100) NOT NULL,
    LASTN_2     VARCHAR(100),
    CR_DATE     TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    PROF_PIC    VARCHAR(255),
    LAST_ACC    TIMESTAMP WITH TIME ZONE,
    BIRTHDATE   DATE
);

CREATE TABLE IF NOT EXISTS core.CORPS(
    ID              BIGINT PRIMARY KEY,
    ID_PLAN         INT NOT NULL REFERENCES catalogs.PLANS(ID),
    ID_STATUS       SMALLINT NOT NULL REFERENCES catalogs.STAT_CAT_CORPS( ID ),
    ID_STRIPE       VARCHAR(100) UNIQUE,
    BILLING_EMAIL   VARCHAR(100),
    COMERCIAL_NAME  VARCHAR(100) NOT NULL,
    LEGAL_NAME      VARCHAR(100) UNIQUE,
    RFC             VARCHAR(20) UNIQUE,
    LOGO            VARCHAR(255),
    SLUG            VARCHAR(100) UNIQUE,
    CUSTOM_DOM      VARCHAR(100) UNIQUE,
    CONTRACT_START  DATE NOT NULL,
    CONTRACT_END    DATE NOT NULL,
    CUSTOM_SETTINGS JSONB NOT NULL,
    CREATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE IF NOT EXISTS core.CORPS_OWNERS(
    ID_CORP     BIGINT NOT NULL REFERENCES core.CORPS(ID),
    ID_USR      BIGINT NOT NULL REFERENCES core.USERS(ID),
    ASIGN_AT    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    PERC        NUMERIC(5, 2) NOT NULL,
    IS_MAIN     BOOLEAN NOT NULL,
    IS_ACTIVE   BOOLEAN NOT NULL,
    PRIMARY KEY(ID_CORP, ID_USR)
);

CREATE TABLE IF NOT EXISTS core.SHOPS(
    ID              BIGINT PRIMARY KEY,
    ID_CORP         BIGINT NOT NULL REFERENCES core.CORPS(ID),
    ID_STATUS       SMALLINT NOT NULL REFERENCES catalogs.STAT_CAT_SH(ID),
    COMER_NAME      VARCHAR(100) NOT NULL,
    LOGO            VARCHAR(255),
    DESCRIPTION     VARCHAR(255),
    PHONE_NUM       VARCHAR(20),
    CLABE_IBAN      VARCHAR(50),
    SLUG            VARCHAR(100) UNIQUE,
    CREATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE IF NOT EXISTS core.PRODUCTS(
    ID              BIGINT PRIMARY KEY,
    ID_SHOP         BIGINT NOT NULL REFERENCES core.SHOPS(ID),
    ID_STATUS       SMALLINT NOT NULL REFERENCES catalogs.STAT_CAT_PR(ID),
    SKU             VARCHAR(50),
    IS_NEW          BOOLEAN NOT NULL,
    DISCOUNT_TYPE   BOOLEAN NOT NULL,
    DISCOUNT_ST     NUMERIC(10, 2),
    PRICE_ST        NUMERIC(10, 2) NOT NULL,
    NAME            VARCHAR(100) NOT NULL,
    STAND_STOCK     NUMERIC(10, 3) NOT NULL,
    WARE_STOCK      NUMERIC(10, 3) NOT NULL,
    WARN_STOCK      NUMERIC(10, 3) NOT NULL,
    CREATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT      TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UNIQUE(ID_SHOP, SKU)
);

CREATE TABLE IF NOT EXISTS core.SH_ADMINS(
    ID_SHOP     BIGINT NOT NULL REFERENCES core.SHOPS(ID),
    ID_USR      BIGINT NOT NULL REFERENCES core.USERS(ID),
    ASIGN_AT    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    IS_GEN      BOOLEAN NOT NULL,
    IS_ACTIVE   BOOLEAN NOT NULL,
    PRIMARY KEY(ID_SHOP, ID_USR)
);

CREATE TABLE IF NOT EXISTS core.SH_SELLERS(
    ID_SHOP     BIGINT NOT NULL REFERENCES core.SHOPS(ID),
    ID_USR      BIGINT NOT NULL REFERENCES core.USERS(ID),
    ASIGN_AT    TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    IS_ACTIVE   BOOLEAN NOT NULL,
    PRIMARY KEY(ID_SHOP, ID_USR)
);

-- Tablas de finanzas
CREATE TABLE IF NOT EXISTS finances.EXPENSES(
    ID              BIGINT PRIMARY KEY,
    ID_SHOP         BIGINT NOT NULL REFERENCES core.SHOPS(ID),
    ID_TYPE         SMALLINT NOT NULL REFERENCES catalogs.EXP_TYPE_CAT(ID),
    ID_USR          BIGINT NOT NULL REFERENCES core.USERS(ID),
    AMOUNT          NUMERIC(10, 2) NOT NULL,
    CONCEPT         VARCHAR(255) NOT NULL,
    TICKET_URL      VARCHAR(255),
    EXP_DATE        TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    IS_CANCELLED    BOOLEAN NOT NULL
);

CREATE TABLE IF NOT EXISTS finances.EXPENSE_DETAILS(
    ID              BIGINT PRIMARY KEY,
    ID_EXPENSE      BIGINT NOT NULL REFERENCES finances.EXPENSES(ID),
    ID_PRODUCT      BIGINT NOT NULL REFERENCES core.PRODUCTS(ID),
    QTY_ADDED       NUMERIC(10,3) NOT NULL,
    UNIT_COST       NUMERIC(10, 2) NOT NULL,
    SUBTOTAL        NUMERIC(10, 2) NOT NULL,
    DESTINATION     BOOLEAN NOT NULL
);

CREATE TABLE IF NOT EXISTS finances.SALES(
    ID                 BIGINT PRIMARY KEY,
    ID_SHOP            BIGINT NOT NULL REFERENCES core.SHOPS(ID),
    ID_USR             BIGINT NOT NULL REFERENCES core.USERS(ID),
    TOTAL_AMOUNT       NUMERIC(10, 2) NOT NULL,
    PAID_AMOUNT        NUMERIC(10, 2) NOT NULL,
    CHANGE_AMOUNT      NUMERIC(10, 2) NOT NULL,
    SALE_DATE          TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    IS_CANCELLED       BOOLEAN NOT NULL
);

CREATE TABLE IF NOT EXISTS finances.SALE_DETAILS(
    ID              BIGINT PRIMARY KEY,
    ID_SALE         BIGINT NOT NULL REFERENCES finances.SALES(ID),
    ID_PRODUCT      BIGINT NOT NULL REFERENCES core.PRODUCTS(ID),
    QTY_SOLD        NUMERIC(10, 3) NOT NULL,
    UNIT_PRICE      NUMERIC(10, 2) NOT NULL,
    SUBTOTAL        NUMERIC(10, 2) NOT NULL
);

-- Tablas de auditoría
CREATE TABLE IF NOT EXISTS logs.AUDITORIAS(
    ID                  BIGINT PRIMARY KEY,
    ID_USR              BIGINT NOT NULL REFERENCES core.USERS(ID),
    TABLE_NAME          VARCHAR(100) NOT NULL,
    TRANSACTION_TYPE    VARCHAR(50) NOT NULL,
    DATE                TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    USER_AGENT          TEXT NOT NULL
);